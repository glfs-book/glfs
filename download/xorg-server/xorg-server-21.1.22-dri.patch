-static void
-setScalar(__GLXconfig * config, unsigned int attrib, unsigned int value)
-{
-    int i;
-
-    for (i = 0; i < ARRAY_SIZE(attribMap); i++)
-        if (attribMap[i].attrib == attrib) {
-            *(unsigned int *) ((char *) config + attribMap[i].offset) = value;
-            return;
-        }
-}
