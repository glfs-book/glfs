diff '--color=auto' -Naurp xorg-server-21.1.22.orig/glx/glx_dri/glxdriswrast.c xorg-server-21.1.22/glx/glx_dri/glxdriswrast.c
--- xorg-server-21.1.22.orig/glx/glx_dri/glxdriswrast.c	1969-12-31 17:00:00.000000000 -0700
+++ xorg-server-21.1.22/glx/glx_dri/glxdriswrast.c	2026-04-14 07:32:43.000000000 -0600
@@ -0,0 +1,488 @@
