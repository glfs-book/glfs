-static void
-copy_box(__GLXdrawable * drawable,
-         int dst, int src,
-         int x, int y, int w, int h)
-{
-    BoxRec box;
-    RegionRec region;
-    __GLXcontext *cx = lastGLContext;
-
-    box.x1 = x;
-    box.y1 = y;
-    box.x2 = x + w;
-    box.y2 = y + h;
-    RegionInit(&region, &box, 0);
-
-    DRI2CopyRegion(drawable->pDraw, &region, dst, src);
-    if (cx != lastGLContext) {
-        lastGLContext = cx;
-        cx->makeCurrent(cx);
-    }
