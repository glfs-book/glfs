<sect1 id="nv-codec-headers" xreflabel="nv-codec-headers-&nv-codec-headers-version; (ffnvcodec)">
  <?dbhtml filename="nv-codec-headers.html"?>

  <title>nv-codec-headers-&nv-codec-headers-version; (ffnvcodec)</title>

  <indexterm zone="nv-codec-headers">
    <primary sortas="a-nv-codec-headers">nv-codec-headers (ffnvcodec)</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduction to nv-codec-headers</title>

    <para>
      The nv-codec-headers package provides headers for interacting
      with NVIDIA codec APIs. This package also goes by the name of ffnvcodec.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Download: <ulink url="&nv-codec-headers-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installation of nv-codec-headers</title>

    <para>
      Install nv-codec-headers by running the following
      command as the &root; user:
    </para>

<screen role="root"><userinput>make PREFIX=/usr LIBDIR=share install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Contents</title>

    <segmentedlist>
      <segtitle>Installed Programs</segtitle>
      <segtitle>Installed Libraries</segtitle>
      <segtitle>Installed Directories</segtitle>

      <seglistitem>
        <seg>
          None
        </seg>
        <seg>
          None
        </seg>
        <seg>
          /usr/include/ffnvcodec
        </seg>
      </seglistitem>
    </segmentedlist>

  </sect2>

