<sect1 id="cbindgen" xreflabel="Cbindgen-&cbindgen-version;">
  <?dbhtml filename="cbindgen.html"?>

  <title>Cbindgen-&cbindgen-version;</title>

  <indexterm zone="cbindgen">
    <primary sortas="a-cbindgen">cbindgen</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduction to Cbindgen</title>

    <para>
      Cbindgen can be used to generate C bindings for
      Rust code.
    </para>

    &build-use-network;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Download: <ulink url="&cbindgen-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">cbindgen Dependencies</bridgehead>

    <para role="required">
      <xref linkend="rustc"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installation of cbindgen</title>
    <para>
      Install cbindgen by running the following
      commands:
    </para>

<screen><userinput>cargo build --release</userinput></screen>

    <para>
      Now, as the <systemitem class="username">root</systemitem> user:
    </para>

<screen role="root"><userinput>&install-exec; target/release/cbindgen -t /usr/bin/</userinput></screen>

  </sect2>

