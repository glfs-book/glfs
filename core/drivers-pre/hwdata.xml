  </indexterm>

  <sect2 role="package">
    <title>Introduction to hwdata</title>

    <para>
      The hwdata package contains current PCI and vendor id data.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Download: <ulink url="&hwdata-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installation of hwdata</title>

    <para>
      Install hwdata by running the following commands:
    </para>

<screen><userinput>./configure --prefix=/usr --disable-blacklist</userinput></screen>

    <para>
      Now, as the &root; user:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Command Explanations</title>

    &options-configure;

  </sect2>

